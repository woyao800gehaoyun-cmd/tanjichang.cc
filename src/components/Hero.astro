---
import { heroData } from '../data/homepage';
---

<section class="relative overflow-hidden py-14 sm:py-20">
  <!-- 明亮动态背景光球 -->
  <div class="pointer-events-none absolute -top-20 -left-20 h-72 w-72 rounded-full bg-indigo-400/20 blur-3xl animate-float"></div>
  <div class="pointer-events-none absolute top-10 -right-16 h-80 w-80 rounded-full bg-cyan-400/20 blur-3xl animate-float" style="animation-delay: -2.5s;"></div>

  <div class="container-site relative z-10">
    <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-7 space-y-6">
        <div class="inline-flex items-center gap-2 rounded-full border border-indigo-200 bg-white/90 px-4 py-1.5 text-xs font-bold text-indigo-700 shadow-sm">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-cyan-400 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-indigo-600"></span>
          </span>
          <span>{heroData.badge}</span>
        </div>

        <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl lg:text-[2.85rem] lg:leading-[1.2]">
          <span class="bg-gradient-to-r from-indigo-600 via-violet-600 to-cyan-500 bg-clip-text text-transparent animate-gradient">
            2026飞机场导航
          </span>
          与外网加速器实测：少踩坑，直接选稳的
        </h1>

        <p class="max-w-2xl text-base leading-relaxed text-slate-600 sm:text-lg">
          {heroData.subtitle}
        </p>

        <div class="flex flex-wrap items-center gap-3.5 pt-2">
          <a href={heroData.primaryCta.href} class="btn-primary">
            {heroData.primaryCta.label}
          </a>
          <a href={heroData.secondaryCta.href} class="btn-secondary">
            {heroData.secondaryCta.label}
          </a>
        </div>

        <!-- 快捷关键词胶囊 -->
        <div class="flex flex-wrap items-center gap-2 pt-2 text-xs">
          <span class="font-semibold text-slate-500">热门直达：</span>
          <a href="/brands/guangnianti/" class="rounded-full bg-orange-100 px-3 py-1 font-bold text-orange-700 hover:bg-orange-200">光年梯VPN</a>
          <a href="/brands/guangnianti/" class="rounded-full bg-indigo-100 px-3 py-1 font-bold text-indigo-700 hover:bg-indigo-200">光年梯机场</a>
          <a href="/blog/proxy-ip-basics/" class="rounded-full bg-cyan-100 px-3 py-1 font-bold text-cyan-800 hover:bg-cyan-200">代理IP科普</a>
          <a href="/blog/cross-border-accelerator-2026/" class="rounded-full bg-emerald-100 px-3 py-1 font-bold text-emerald-800 hover:bg-emerald-200">2026外网加速器</a>
        </div>
      </div>

      <!-- 右侧 TOP 1 光年梯高亮推荐卡片 -->
      <div class="lg:col-span-5">
        <div class="card-surface card-interactive relative overflow-hidden border-2 border-indigo-200/90 p-6 sm:p-7 bg-gradient-to-br from-white via-indigo-50/40 to-cyan-50/50">
          <div class="mb-5 flex items-center justify-between border-b border-indigo-100 pb-4">
            <div>
              <span class="inline-block rounded-full bg-gradient-to-r from-orange-500 to-pink-500 px-2.5 py-0.5 text-[11px] font-extrabold text-white">
                {heroData.highlightCard.label}
              </span>
              <h2 class="mt-2 text-xl font-extrabold text-slate-900">
                {heroData.highlightCard.title}
              </h2>
            </div>
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br from-indigo-600 to-cyan-500 text-lg font-extrabold text-white shadow-md">
              #1
            </div>
          </div>

          <ul class="space-y-4">
            {heroData.highlightCard.items.map((item, idx) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-lg bg-indigo-600 text-xs font-bold text-white">
                  {idx + 1}
                </span>
                <div>
                  <p class="text-sm font-bold text-slate-900">{item.title}</p>
                  <p class="mt-0.5 text-xs leading-relaxed text-slate-600">{item.desc}</p>
                </div>
              </li>
            ))}
          </ul>

          <div class="mt-6 flex items-center justify-between gap-3 rounded-xl bg-white/90 px-4 py-3 border border-indigo-100">
            <span class="text-xs font-medium text-slate-500">{heroData.highlightCard.footerText}</span>
            <a href="/brands/guangnianti/" class="shrink-0 text-xs font-extrabold text-indigo-600 hover:text-indigo-800">
              查看详情 &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
