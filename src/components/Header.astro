---
import { siteConfig } from '../data/site';
import { navZones, headerCta } from '../data/nav';
---

<header class="sticky top-0 z-50 border-b border-indigo-100/90 bg-white/85 backdrop-blur-xl shadow-sm">
  <!-- 顶部流光动态彩条 -->
  <div class="nav-glow-bar h-1 w-full bg-gradient-to-r from-indigo-500 via-cyan-400 to-orange-500"></div>

  <div class="container-site flex h-16 items-center justify-between gap-4">
    <!-- Logo -->
    <a href="/" class="group flex items-center gap-2.5 shrink-0">
      <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-indigo-600 via-violet-500 to-cyan-500 text-base font-extrabold text-white shadow-md group-hover:scale-105 group-hover:rotate-3 transition-transform">
        {siteConfig.shortName}
      </span>
      <div class="leading-tight">
        <span class="block text-base font-extrabold tracking-tight text-slate-900">
          {siteConfig.name}
        </span>
        <span class="block text-[11px] font-semibold text-indigo-600">
          {siteConfig.domain}
        </span>
      </div>
    </a>

    <!-- 三大内容分区导航（桌面端：悬停展开胶囊交互） -->
    <nav aria-label="三分区主导航" class="hidden lg:flex items-center gap-2.5">
      {navZones.map((zone) => (
        <div class="group relative">
          <button
            type="button"
            class="flex items-center gap-2 rounded-full border border-slate-200/90 bg-slate-50/90 px-4 py-1.5 text-sm font-bold text-slate-800 hover:border-indigo-300 hover:bg-white hover:text-indigo-700 hover:shadow-md transition-all cursor-pointer"
          >
            <span class={`h-2 w-2 rounded-full bg-gradient-to-r ${zone.colorClass}`}></span>
            <span>{zone.zoneLabel}</span>
            <svg class="h-3.5 w-3.5 text-slate-400 group-hover:rotate-180 group-hover:text-indigo-600 transition-transform" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
            </svg>
          </button>

          <!-- 下拉浮层卡片 -->
          <div class="pointer-events-none absolute left-0 top-full pt-2 opacity-0 translate-y-2 group-hover:pointer-events-auto group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200">
            <div class="w-56 rounded-2xl border border-indigo-100 bg-white/95 p-2 shadow-xl backdrop-blur-xl">
              {zone.items.map((item) => (
                <a
                  href={item.href}
                  class="flex items-center justify-between rounded-xl px-3.5 py-2.5 text-sm font-semibold text-slate-700 hover:bg-gradient-to-r hover:from-indigo-50 hover:to-cyan-50 hover:text-indigo-700"
                >
                  <span>{item.label}</span>
                  {item.badge && (
                    <span class="rounded-full bg-gradient-to-r from-orange-500 to-pink-500 px-2 py-0.5 text-[10px] font-bold text-white">
                      {item.badge}
                    </span>
                  )}
                </a>
              ))}
            </div>
          </div>
        </div>
      ))}
    </nav>

    <!-- 右侧高亮 CTA -->
    <div class="flex items-center gap-2.5">
      <a href="/compare/" class="hidden sm:inline-flex rounded-xl border border-indigo-200 bg-indigo-50/70 px-3.5 py-2 text-xs font-bold text-indigo-700 hover:bg-indigo-100">
        6家对比表
      </a>
      <a href={headerCta.href} class="btn-primary !py-2 !px-4 !text-xs sm:!text-sm">
        <span>{headerCta.label}</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>

  <!-- 移动端三分区横向滑动条 -->
  <nav aria-label="移动端三分区导航" class="flex lg:hidden items-center gap-2 overflow-x-auto border-t border-indigo-50 bg-white/90 px-4 py-2 text-xs">
    {navZones.flatMap((z) => z.items).map((item) => (
      <a
        href={item.href}
        class="shrink-0 rounded-full border border-indigo-100 bg-indigo-50/60 px-3 py-1 font-semibold text-indigo-800 hover:bg-indigo-600 hover:text-white"
      >
        {item.label}
      </a>
    ))}
  </nav>
</header>
