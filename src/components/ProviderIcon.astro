---
export interface Props {
  id: string;
  rank: number;
}

const { id, rank } = Astro.props;

const bgMap: Record<string, string> = {
  guangnianti: 'from-orange-500 via-rose-500 to-pink-500 shadow-orange-200',
  jilianyun: 'from-blue-600 via-indigo-500 to-cyan-400 shadow-blue-200',
  kuaili: 'from-amber-400 via-orange-500 to-red-500 shadow-amber-200',
  sujie: 'from-indigo-600 via-violet-600 to-purple-500 shadow-indigo-200',
  kexinyun: 'from-emerald-500 via-teal-500 to-cyan-500 shadow-emerald-200',
  bianyuanjiedian: 'from-fuchsia-600 via-purple-600 to-indigo-600 shadow-fuchsia-200',
};

const bgClass = bgMap[id] || 'from-slate-700 to-slate-900 shadow-slate-200';
---

<div class="relative shrink-0">
  <div class={`flex h-11 w-11 items-center justify-center rounded-2xl bg-gradient-to-br ${bgClass} text-white shadow-md`}>
    {id === 'guangnianti' && (
      <!-- 光年梯：光速星芒与跃迁轨迹 -->
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2l2.2 6.2L20 10.5l-5.8 2.3L12 19l-2.2-6.2L4 10.5l5.8-2.3L12 2z" fill="currentColor" fill-opacity="0.25" />
        <path d="M4 20l5-5" />
        <path d="M19 4l-2 2" />
      </svg>
    )}
    {id === 'jilianyun' && (
      <!-- 极连云：极速互联云朵 -->
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M17.5 19H9a5 5 0 1 1 1.3-9.8A6 6 0 0 1 21 12.5a3.5 3.5 0 0 1-3.5 6.5z" fill="currentColor" fill-opacity="0.22" />
        <path d="M13 11l-2 4h3l-2 4" />
      </svg>
    )}
    {id === 'kuaili' && (
      <!-- 快狸：灵动几何狐耳 + 闪电 -->
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 4l3 5h8l3-5 1 9-8 7-8-7 1-9z" fill="currentColor" fill-opacity="0.22" />
        <circle cx="9.5" cy="12" r="1" fill="currentColor" />
        <circle cx="14.5" cy="12" r="1" fill="currentColor" />
      </svg>
    )}
    {id === 'sujie' && (
      <!-- 速界：全球跨境光环 -->
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="8" fill="currentColor" fill-opacity="0.18" />
        <ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(-25 12 12)" />
        <path d="M12 4a12 12 0 0 1 0 16" />
      </svg>
    )}
    {id === 'kexinyun' && (
      <!-- 可信云：安全盾牌与认证对勾 -->
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3l7 3v5c0 4.5-3 8.2-7 10-4-1.8-7-5.5-7-10V6l7-3z" fill="currentColor" fill-opacity="0.22" />
        <path d="M9 12l2 2 4-4" />
      </svg>
    )}
    {id === 'bianyuanjiedian' && (
      <!-- 边缘节点：六边形分布式节点网络 -->
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="12 3 19 7.5 19 16.5 12 21 5 16.5 5 7.5 12 3" fill="currentColor" fill-opacity="0.2" />
        <circle cx="12" cy="12" r="2.2" fill="currentColor" />
        <path d="M12 3v6.8M19 16.5l-5-3.2M5 16.5l5-3.2" />
      </svg>
    )}
  </div>
  <span class="absolute -top-1.5 -right-1.5 flex h-5 min-w-5 items-center justify-center rounded-full bg-slate-900 px-1 text-[10px] font-extrabold text-white ring-2 ring-white">
    #{rank}
  </span>
</div>
