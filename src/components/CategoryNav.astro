---
import { categories } from '../data/categories';
export interface Props { activeSlug?: string; }
const { activeSlug } = Astro.props;
---
<div class="mb-8 flex flex-wrap gap-2">
  <a href="/blog/" class:list={['rounded-full border px-4 py-1.5 text-sm font-bold', !activeSlug ? 'border-indigo-600 bg-indigo-600 text-white' : 'border-indigo-100 bg-white text-slate-700 hover:bg-indigo-50']}>全部文章</a>
  {categories.map((cat) => (
    <a href={`/category/${cat.slug}/`} class:list={['rounded-full border px-4 py-1.5 text-sm font-bold', activeSlug === cat.slug ? 'border-indigo-600 bg-indigo-600 text-white' : 'border-indigo-100 bg-white text-slate-700 hover:bg-indigo-50']}>{cat.name}</a>
  ))}
</div>
