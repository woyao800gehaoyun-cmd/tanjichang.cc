---
import LandingLayout from '../../layouts/LandingLayout.astro';
import CTASection from '../../components/CTASection.astro';
import { faqGroups } from '../../data/faq';

const allFaqs = faqGroups.flatMap((g) => g.items);

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: allFaqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<LandingLayout
  eyebrow="FAQ 问答百科 · 2026 全量收录"
  title="机场推荐、梯子客户端与代理科普常见问题大全"
  description="一站式解答 2026 机场推荐、Clash/小火箭/v2rayN 订阅导入、IPLC/IEPL 专线区别、ChatGPT 与 Netflix 解锁、优惠码使用及防跑路避坑等全部高频问题。"
  breadcrumbs={[{ label: 'FAQ 问答百科' }]}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <!-- 实时关键词搜索框 + 8 大分类锚点 -->
  <div class="card-surface p-6 sm:p-7 mb-10 space-y-5">
    <div class="relative">
      <input
        id="faq-search"
        type="search"
        placeholder="输入关键词秒搜问题，例如：Clash、小火箭、IPLC、ChatGPT、优惠码、光年梯、晚高峰..."
        class="w-full rounded-2xl border-2 border-indigo-200 bg-white px-5 py-3.5 text-sm font-medium text-slate-900 placeholder:text-slate-400 focus:border-indigo-500 focus:outline-none"
      />
    </div>

    <div class="flex flex-wrap gap-2">
      {faqGroups.map((group) => (
        <a
          href={`#${group.id}`}
          class="rounded-full border border-indigo-100 bg-indigo-50/70 px-3.5 py-1.5 text-xs font-bold text-indigo-700 hover:bg-indigo-600 hover:text-white"
        >
          {group.title.split('：')[0]}
        </a>
      ))}
    </div>
  </div>

  <!-- 8 大主题问答区 -->
  <div class="space-y-12" id="faq-container">
    {faqGroups.map((group) => (
      <section id={group.id} class="faq-group scroll-mt-24 space-y-4">
        <div class="flex flex-wrap items-center gap-3">
          <span class="rounded-full bg-gradient-to-r from-indigo-600 to-cyan-500 px-3 py-0.5 text-xs font-extrabold text-white">
            {group.badge}
          </span>
          <h2 class="text-xl font-extrabold text-slate-900 sm:text-2xl">
            {group.title}
          </h2>
        </div>

        <div class="space-y-3">
          {group.items.map((item, idx) => (
            <details class="faq-item group" open={idx === 0}>
              <summary class="flex items-center justify-between gap-4 px-5 py-4 text-sm font-bold text-slate-900 sm:text-base">
                <span>{item.q}</span>
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600 transition-transform group-open:rotate-45">
                  +
                </span>
              </summary>
              <div class="border-t border-slate-100 px-5 py-4 text-sm leading-relaxed text-slate-600">
                {item.a}
              </div>
            </details>
          ))}
        </div>
      </section>
    ))}
  </div>

  <p id="faq-empty" class="hidden card-surface p-10 text-center text-sm font-semibold text-slate-500">
    未找到匹配的问答，换个短词试试（如：Clash、专线、优惠码、ChatGPT）。
  </p>
</LandingLayout>

<CTASection
  title="看完问答准备上手？直接看 2026 机场排行榜"
  description="光年梯（13元/月 120G，优惠码 GNT80）、极连云（15元/月 120G，优惠码 JLY888）等 6 家实测直达。"
  primaryText="返回首页看榜单"
  primaryHref="/#rankings"
  secondaryText="查看 6 家对比表"
  secondaryHref="/compare/"
/>

<script is:inline>
  const searchInput = document.getElementById('faq-search');
  const groups = document.querySelectorAll('.faq-group');
  const emptyTip = document.getElementById('faq-empty');

  if (searchInput) {
    searchInput.addEventListener('input', () => {
      const kw = searchInput.value.trim().toLowerCase();
      let totalVisible = 0;

      groups.forEach((group) => {
        const items = group.querySelectorAll('.faq-item');
        let groupVisible = 0;
        items.forEach((item) => {
          const text = item.textContent.toLowerCase();
          const match = !kw || text.includes(kw);
          item.style.display = match ? '' : 'none';
          if (match) {
            groupVisible++;
            totalVisible++;
            if (kw) item.setAttribute('open', '');
          }
        });
        group.style.display = groupVisible > 0 ? '' : 'none';
      });

      if (emptyTip) {
        emptyTip.classList.toggle('hidden', totalVisible > 0);
      }
    });
  }
</script>
