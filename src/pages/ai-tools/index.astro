---
import LandingLayout from '../../layouts/LandingLayout.astro';
import CTASection from '../../components/CTASection.astro';
import { aiTools, aiToolCategories } from '../../data/aiTools';

const aiToolsJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: '2026 AI 工具导航 - ChatGPT / Claude / Midjourney / Cursor 官网直达',
  itemListElement: aiTools.map((t, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: t.name,
    url: t.url,
    description: t.desc,
  })),
};
---

<LandingLayout
  eyebrow="AI Tools Directory · 2026 实时精选"
  title="AI 工具导航 2026 — ChatGPT / Claude / Midjourney / Cursor 官网直达"
  description="探机场（tanjichang.cc）精选 2026 热门 AI 工具官网直达，涵盖 AI 对话、编程、绘画、视频音频与效率办公，并附每款工具的推荐代理节点地区。"
  breadcrumbs={[{ label: 'AI 工具导航' }]}
>
  <script type="application/ld+json" set:html={JSON.stringify(aiToolsJsonLd)} />

  <!-- 顶部提示条：自然关联纯净 IP 机场 -->
  <div class="mb-8 rounded-2xl border border-indigo-200 bg-gradient-to-r from-indigo-50 via-white to-cyan-50 p-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div class="text-sm text-slate-700">
      <strong class="text-indigo-700">访问提示：</strong>
      ChatGPT、Claude、Gemini、Midjourney 等海外 AI 工具对 IP 纯净度要求较高（需避开香港节点，切新加坡/日本/美国）。推荐使用
      <a href="/blog/guangnianti-review-2026/" class="font-extrabold text-indigo-600 underline">光年梯（优惠码 GNT80）</a>
      或查看
      <a href="/blog/iplc-chatgpt-netflix-airport/" class="font-bold text-indigo-600 underline">ChatGPT 专线机场选型指南</a>。
    </div>
    <a href="/#rankings" class="btn-primary shrink-0 !py-2 !px-4 !text-xs">看 2026 机场榜 &rarr;</a>
  </div>

  <!-- 实时搜索 + 分类筛选胶囊 -->
  <div class="card-surface p-5 sm:p-6 mb-8 space-y-4">
    <input
      id="ai-search"
      type="search"
      placeholder="搜工具名或用途，例如：ChatGPT、Claude、写代码、画图、PPT、视频..."
      class="w-full rounded-2xl border-2 border-indigo-200 bg-white px-5 py-3 text-sm font-medium text-slate-900 placeholder:text-slate-400 focus:border-indigo-500 focus:outline-none"
    />
    <div class="flex flex-wrap gap-2" id="ai-filters">
      {aiToolCategories.map((cat, idx) => (
        <button
          type="button"
          data-cat={cat.id}
          class:list={[
            'ai-filter-btn rounded-full px-4 py-1.5 text-xs font-bold cursor-pointer transition-all',
            idx === 0
              ? 'bg-indigo-600 text-white shadow-sm'
              : 'border border-indigo-200 bg-white text-slate-700 hover:bg-indigo-50',
          ]}
        >
          {cat.label}
        </button>
      ))}
    </div>
  </div>

  <!-- 工具卡片网格 -->
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" id="ai-grid">
    {aiTools.map((tool) => (
      <a
        href={tool.url}
        target="_blank"
        rel="noopener noreferrer nofollow"
        data-cat={tool.category}
        class="ai-card card-surface card-interactive group flex flex-col justify-between p-6"
      >
        <div>
          <div class="mb-3 flex items-center justify-between gap-2">
            <div class="flex items-center gap-2.5">
              <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-indigo-600 to-cyan-500 text-sm font-extrabold text-white shadow-sm">
                {tool.name.slice(0, 1)}
              </span>
              <div>
                <h2 class="text-base font-extrabold text-slate-900 group-hover:text-indigo-600 flex items-center gap-1.5">
                  <span>{tool.name}</span>
                  {tool.hot && (
                    <span class="rounded-full bg-gradient-to-r from-orange-500 to-pink-500 px-2 py-0.5 text-[10px] font-bold text-white">
                      HOT
                    </span>
                  )}
                </h2>
                <span class="text-[11px] font-semibold text-slate-400">{tool.categoryLabel}</span>
              </div>
            </div>
            <span class="rounded-lg bg-indigo-50 px-2 py-0.5 text-[11px] font-bold text-indigo-700">
              {tool.pricing}
            </span>
          </div>

          <p class="text-sm leading-relaxed text-slate-600">
            {tool.desc}
          </p>
        </div>

        <div class="mt-4 flex items-center justify-between border-t border-slate-100 pt-3 text-xs">
          <span class="font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-md">
            {tool.regionTip}
          </span>
          <span class="font-bold text-indigo-600 group-hover:translate-x-0.5 transition-transform">
            官网直达 &rarr;
          </span>
        </div>
      </a>
    ))}
  </div>

  <p id="ai-empty" class="hidden card-surface p-10 text-center text-sm font-semibold text-slate-500">
    没有找到匹配的 AI 工具，换个关键词试试吧。
  </p>
</LandingLayout>

<CTASection
  title="用 ChatGPT / Claude 老是弹验证？换一条纯净 IP 专线"
  description="光年梯（13元/月 120G，优惠码 GNT80）晚高峰稳跑新加坡/日本/美国原生节点，AI 工具开箱即用。"
  primaryText="查看光年梯测评"
  primaryHref="/blog/guangnianti-review-2026/"
  secondaryText="看全部机场对比"
  secondaryHref="/compare/"
/>

<script is:inline>
  let activeCat = 'all';
  const searchEl = document.getElementById('ai-search');
  const cards = document.querySelectorAll('#ai-grid .ai-card');
  const emptyEl = document.getElementById('ai-empty');

  function applyFilter() {
    const kw = (searchEl?.value || '').trim().toLowerCase();
    let visible = 0;
    cards.forEach((card) => {
      const cat = card.getAttribute('data-cat');
      const text = card.textContent.toLowerCase();
      const ok = (activeCat === 'all' || cat === activeCat) && (!kw || text.includes(kw));
      card.style.display = ok ? '' : 'none';
      if (ok) visible++;
    });
    if (emptyEl) emptyEl.classList.toggle('hidden', visible > 0);
  }

  document.querySelectorAll('#ai-filters .ai-filter-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCat = btn.getAttribute('data-cat') || 'all';
      document.querySelectorAll('#ai-filters .ai-filter-btn').forEach((b) => {
        b.className = 'ai-filter-btn rounded-full border border-indigo-200 bg-white px-4 py-1.5 text-xs font-bold text-slate-700 hover:bg-indigo-50 cursor-pointer transition-all';
      });
      btn.className = 'ai-filter-btn rounded-full bg-indigo-600 px-4 py-1.5 text-xs font-bold text-white shadow-sm cursor-pointer transition-all';
      applyFilter();
    });
  });

  if (searchEl) searchEl.addEventListener('input', applyFilter);
</script>
