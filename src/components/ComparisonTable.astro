---
export interface Props {
  columns: string[];
  rows: string[][];
  caption?: string;
}
const { columns, rows, caption } = Astro.props;
---
<div class="card-surface overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full min-w-[640px] border-collapse text-left text-sm">
      {caption && <caption class="sr-only">{caption}</caption>}
      <thead>
        <tr class="border-b border-indigo-100 bg-indigo-50/70">
          {columns.map((col, idx) => (
            <th scope="col" class:list={['px-5 py-4 font-extrabold text-indigo-950', idx === 0 ? 'w-44' : '']}>{col}</th>
          ))}
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 bg-white">
        {rows.map((row, rIdx) => (
          <tr class:list={['hover:bg-indigo-50/40 transition-colors', rIdx === 0 ? 'bg-orange-50/40' : '']}>
            {row.map((cell, idx) => (
              <td class:list={['px-5 py-4', idx === 0 ? 'font-extrabold text-slate-900' : 'text-slate-600']}>{cell}</td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
