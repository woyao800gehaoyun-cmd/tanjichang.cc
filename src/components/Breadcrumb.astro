---
export interface BreadcrumbItem { label: string; href?: string; }
export interface Props { items: BreadcrumbItem[]; }
const { items } = Astro.props;
---
<nav aria-label="面包屑" class="mb-5 flex flex-wrap items-center gap-2 text-xs text-slate-500 sm:text-sm">
  <a href="/" class="hover:text-indigo-600">首页</a>
  {items.map((item, idx) => (
    <>
      <span class="text-slate-300">/</span>
      {item.href && idx < items.length - 1 ? <a href={item.href} class="hover:text-indigo-600">{item.label}</a> : <span class="font-bold text-slate-700">{item.label}</span>}
    </>
  ))}
</nav>
