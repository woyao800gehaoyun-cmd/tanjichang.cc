---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import CTASection from '../components/CTASection.astro';
import { getCategoryBySlug } from '../data/categories';
import type { RelatedPostItem } from '../components/RelatedPosts.astro';

export interface Props {
  title: string; description: string; pubDate: Date; updatedDate?: Date; category: string; tags: string[]; author: string;
  headings?: { depth: number; slug: string; text: string }[];
  relatedPosts?: RelatedPostItem[];
}
const { title, description, pubDate, updatedDate, category, tags, author, headings = [], relatedPosts = [] } = Astro.props;
const cat = getCategoryBySlug(category);
const categoryLabel = cat ? cat.name : category;
const fmt = (d: Date) => d.toISOString().slice(0, 10);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
<BaseLayout title={title} description={description} ogType="article">
  <div class="container-site py-10 sm:py-14">
    <Breadcrumb items={[{ label: '博客', href: '/blog/' }, { label: categoryLabel, href: `/category/${category}/` }, { label: title }]} />
    <div class="grid gap-10 lg:grid-cols-12">
      <article class="lg:col-span-8">
        <header class="mb-8 border-b border-indigo-100 pb-6">
          <div class="mb-3 flex flex-wrap items-center gap-2 text-xs text-slate-500">
            <a href={`/category/${category}/`} class="rounded-full bg-indigo-50 px-3 py-0.5 font-bold text-indigo-700">{categoryLabel}</a>
            <span>作者：{author}</span>
            <span>发布：{fmt(pubDate)}</span>
            {updatedDate && <span>更新：{fmt(updatedDate)}</span>}
          </div>
          <h1 class="text-2xl font-extrabold text-slate-900 sm:text-3xl">{title}</h1>
          <p class="mt-3 text-base text-slate-600">{description}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <a href={`/tag/${encodeURIComponent(tag)}/`} class="rounded-full border border-indigo-100 bg-white px-3 py-0.5 text-xs font-semibold text-indigo-700 hover:bg-indigo-50">#{tag}</a>
            ))}
          </div>
        </header>
        <div class="card-surface p-6 sm:p-10"><div class="prose-zh"><slot /></div></div>
        <RelatedPosts posts={relatedPosts} />
      </article>
      <aside class="lg:col-span-4 space-y-6">
        <div class="lg:sticky lg:top-24 space-y-6">
          <div class="card-surface p-6">
            <h2 class="text-sm font-extrabold text-slate-900">文章目录</h2>
            <ul class="mt-3 space-y-2 text-sm text-slate-600">
              {toc.map((h) => <li class={h.depth === 3 ? 'pl-4 text-xs' : 'font-semibold'}><a href={`#${h.slug}`} class="hover:text-indigo-600">{h.text}</a></li>)}
            </ul>
          </div>
          <div class="card-surface p-6 bg-gradient-to-br from-indigo-50/70 to-cyan-50/70">
            <h2 class="text-sm font-extrabold text-slate-900">2026 榜首直达</h2>
            <p class="mt-1.5 text-xs text-slate-600">光年梯（光年梯VPN / 光年梯机场）晚高峰稳健首选。</p>
            <a href="/brands/guangnianti/" class="btn-primary mt-4 w-full !py-2 !text-xs">查看光年梯档案</a>
          </div>
        </div>
      </aside>
    </div>
  </div>
  <CTASection />
</BaseLayout>
