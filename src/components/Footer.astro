---
import { siteConfig } from '../data/site';
import { footerNav } from '../data/nav';
const currentYear = new Date().getFullYear();
---

<footer class="mt-20 border-t border-indigo-100 bg-white/90">
  <div class="container-site py-12">
    <div class="grid gap-8 md:grid-cols-12">
      <div class="md:col-span-5 space-y-3">
        <a href="/" class="inline-flex items-center gap-2 font-extrabold text-slate-900">
          <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-gradient-to-br from-indigo-600 to-cyan-500 text-sm text-white">{siteConfig.shortName}</span>
          <span>{siteConfig.name} · {siteConfig.domain}</span>
        </a>
        <p class="max-w-sm text-sm text-slate-600">{siteConfig.description}</p>
      </div>
      <div class="md:col-span-3 space-y-2.5">
        <h3 class="text-sm font-extrabold text-slate-900">内容分类</h3>
        <ul class="space-y-2 text-sm text-slate-600">
          {footerNav.categories.map((item) => (
            <li><a href={item.href} class="hover:text-indigo-600">{item.label}</a></li>
          ))}
        </ul>
      </div>
      <div class="md:col-span-4 space-y-2.5">
        <h3 class="text-sm font-extrabold text-slate-900">快速导航</h3>
        <ul class="grid grid-cols-2 gap-2 text-sm text-slate-600">
          {footerNav.pages.map((item) => (
            <li><a href={item.href} class="hover:text-indigo-600">{item.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
    <div class="mt-8 rounded-xl bg-indigo-50/50 p-4 text-xs text-slate-500 border border-indigo-100">
      {siteConfig.disclaimer}
    </div>
    <div class="mt-6 flex flex-col gap-2 border-t border-slate-100 pt-5 text-xs text-slate-500 sm:flex-row sm:justify-between">
      <p>&copy; {currentYear} {siteConfig.copyright}</p>
      <p>tanjichang.cc · 2026 飞机场导航与外网加速器实测站</p>
    </div>
  </div>
</footer>
