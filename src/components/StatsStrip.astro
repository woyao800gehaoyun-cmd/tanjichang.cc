---
export interface Props {
  items: { value: string; label: string; note?: string }[];
}
const { items } = Astro.props;
---
<section class="py-4">
  <div class="container-site">
    <div class="card-surface grid grid-cols-2 divide-y divide-indigo-50 sm:grid-cols-4 sm:divide-x sm:divide-y-0">
      {items.map((item) => (
        <div class="p-5 sm:p-6">
          <p class="text-2xl font-extrabold bg-gradient-to-r from-indigo-600 to-cyan-500 bg-clip-text text-transparent sm:text-3xl">{item.value}</p>
          <p class="mt-1 text-sm font-bold text-slate-800">{item.label}</p>
          {item.note && <p class="mt-0.5 text-xs text-slate-500">{item.note}</p>}
        </div>
      ))}
    </div>
  </div>
</section>
